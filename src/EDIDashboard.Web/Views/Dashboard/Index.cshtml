          <option value="">TA1 + 999</option>
          <option value="TA1">TA1 Only</option>
          <option value="999">999 Only</option>
        </select>
        <button class="btn btn-secondary" onclick="loadAcks()">Refresh</button>
      </div>
      <div class="panel">
        <div class="panel-header"><span class="panel-title">Acknowledgments</span></div>
        <table>
          <thead><tr><th>Type</th><th>Control #</th><th>File Name</th><th>Partner</th><th>Code</th><th>Description</th><th>Received</th></tr></thead>
          <tbody id="ack-tbody"><tr><td colspan="7"><div class="empty-state"><p>Loading…</p></div></td></tr></tbody>
