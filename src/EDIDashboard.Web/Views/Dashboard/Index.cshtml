          <div class="kpi-sub">Awaiting acknowledgment</div>
          <div class="kpi-icon"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div>
        </div>
        <div class="kpi-card" style="--kpi-color:#ffc800">
          <div class="kpi-label">Total Billed</div>
          <div class="kpi-value" id="kpi-amount" style="font-size:20px">—</div>
