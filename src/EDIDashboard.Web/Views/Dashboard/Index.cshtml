          <div class="kpi-icon"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></div>
        </div>
        <div class="kpi-card" style="--kpi-color:#0088ff">
          <div class="kpi-label">Pending Review</div>
