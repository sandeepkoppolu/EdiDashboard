<!-- ══ PARTNER MODAL ══ -->
<div class="modal-overlay" id="partner-modal">
  <div class="modal">
    <button class="modal-close" onclick="document.getElementById('partner-modal').classList.remove('open')">✕</button>
    <h2 id="partner-modal-title">Add Trading Partner</h2>
    <p class="modal-sub">Configure a new EDI trading partner</p>
    <input type="hidden" id="partner-id" value="" />
    <div class="form-group">
      <label class="form-label">Partner Name</label>
      <input class="form-control" id="partner-name" placeholder="e.g. Blue Cross Blue Shield" />
    </div>
    <div class="form-group">
      <label class="form-label">Interchange ID (ISA06)</label>
      <input class="form-control" id="partner-interchange-id" placeholder="e.g. BCBS001" style="font-family:var(--mono)" />
    </div>
    <div class="form-group">
      <label class="form-label">Interchange Qualifier (ISA05)</label>
      <select class="form-control" id="partner-qualifier">
        <option value="ZZ">ZZ – Mutually Defined</option>
        <option value="01">01 – Duns</option>
        <option value="30">30 – U.S. Federal Tax ID</option>
        <option value="NI">NI – National Association of Insurance Commissioners</option>
      </select>
    </div>
    <div class="form-group">
      <label class="form-label">Status</label>
      <select class="form-control" id="partner-active">
        <option value="true">Active</option>
        <option value="false">Inactive</option>
      </select>
    </div>
    <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:8px;">
      <button class="btn btn-secondary" onclick="document.getElementById('partner-modal').classList.remove('open')">Cancel</button>
      <button class="btn btn-primary" onclick="savePartner()">Save Partner</button>
    </div>
  </div>
</div>

<!-- Toast container -->
<div class="toast-container" id="toasts"></div>

<script>
// ─── State ────────────────────────────────────────────────────────────────────
let partners = [];
let selectedPartnerId = null;
let txPage = 1, claimPage = 1, ackPage = 1;
const PAGE_SIZE = 25;
let dashboardRequestId = 0;
const API_BASE_URL = '@(Config["Api:BaseUrl"] ?? "")'.replace(/\/+$/, '');

function apiUrl(path) {
  const normalizedPath = path.startsWith('/') ? path : '/' + path;
  return API_BASE_URL ? API_BASE_URL + normalizedPath : normalizedPath;
}

function setTheme(theme) {
  document.body.classList.remove('theme-light', 'theme-dark');
  document.body.classList.add(theme);
  localStorage.setItem('edi-theme', theme);
}

function toggleTheme() {
  const current = document.body.classList.contains('theme-light') ? 'theme-light' : 'theme-dark';
  setTheme(current === 'theme-light' ? 'theme-dark' : 'theme-light');
}

// ─── Init ─────────────────────────────────────────────────────────────────────
(async () => {
  const saved = localStorage.getItem('edi-theme');
  setTheme(saved === 'theme-dark' ? 'theme-dark' : 'theme-light');
  try {
    await loadPartners();
  } catch (e) {
    console.error('Failed to auto-load trading partners:', e);
  }
  loadDashboard();
  setupDropZone();
})();

// ─── Navigation ──────────────────────────────────────────────────────────────
function showSection(name, navEl) {
  document.querySelectorAll('[id^="section-"]').forEach(s => s.style.display = 'none');
  document.getElementById('section-' + name).style.display = '';
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  if (navEl) navEl.classList.add('active');
  document.getElementById('page-title').textContent =
    {dashboard:'Dashboard', transactions:'Transactions', claims:'Claims', acks:'Acknowledgments', partners:'Trading Partners'}[name] || name;

  if (name === 'transactions') loadTransactions();
  if (name === 'claims')       loadClaims();
  if (name === 'acks')         loadAcks();
  if (name === 'partners')     renderPartnersTable();
}

function globalFilter() {
  selectedPartnerId = document.getElementById('global-partner').value || null;
  txPage = 1;
  claimPage = 1;
  ackPage = 1;

  if (document.getElementById('section-transactions').style.display !== 'none') {
    loadTransactions();
    return;
  }

  if (document.getElementById('section-claims').style.display !== 'none') {
    loadClaims();
    return;
  }

  if (document.getElementById('section-acks').style.display !== 'none') {
    loadAcks();
    return;
  }

  loadDashboard();
}

// ─── Partners ─────────────────────────────────────────────────────────────────
async function loadPartners() {
  const partnerUrls = [apiUrl('/api/tradingpartners'), apiUrl('/api/TradingPartners')];
  let loaded = null;

  for (const url of partnerUrls) {
    try {
      const res = await fetch(url, { headers: { 'Accept': 'application/json' } });
      if (!res.ok) continue;
      const data = await res.json();
      if (Array.isArray(data)) {
        loaded = data;
        break;
      }
    } catch (e) {
      console.warn('Partner endpoint failed:', url, e);
    }
  }

  partners = Array.isArray(loaded) ? loaded : [];
  const opts = partners.map(p => `<option value="${p.id}">${p.name}</option>`).join('');

  const globalEl = document.getElementById('global-partner');
  const uploadEl = document.getElementById('upload-partner');
  const currentGlobal = globalEl.value;
  const currentUpload = uploadEl.value;

  globalEl.innerHTML = '<option value="">All Partners</option>' + opts;
  uploadEl.innerHTML = '<option value="">Auto-detect from ISA06 (create if new)</option>' + opts;

  if (currentGlobal && partners.some(p => String(p.id) === currentGlobal)) {
    globalEl.value = currentGlobal;
  }
  if (currentUpload && partners.some(p => String(p.id) === currentUpload)) {
    uploadEl.value = currentUpload;
  }
}

function renderPartnersTable() {
  const tbody = document.getElementById('partners-tbody');
  if (!partners.length) { tbody.innerHTML = '<tr><td colspan="6"><div class="empty-state"><p>No trading partners yet.</p></div></td></tr>'; return; }
  tbody.innerHTML = partners.map(p => `
    <tr>
      <td style="font-family:var(--mono);color:var(--muted)">${p.id}</td>
      <td><strong>${p.name}</strong>${p.name && p.name.startsWith('Auto-') ? ' <span class="badge badge-auto-created" style="font-size:9px;margin-left:6px">Auto-Created</span>' : ''}</td>
      <td style="font-family:var(--mono)">${p.interchangeId || '—'}</td>
      <td style="font-family:var(--mono)">${p.interchangeQualifier || '—'}</td>
      <td><span class="badge ${p.isActive ? 'badge-accepted' : 'badge-rejected'}">${p.isActive ? 'Active' : 'Inactive'}</span></td>
      <td>
        <button class="btn btn-secondary" style="padding:4px 10px;font-size:12px" onclick='editPartner(${JSON.stringify(p)})'>Edit</button>
        <button class="btn btn-danger" style="padding:4px 10px;font-size:12px;margin-left:6px" onclick="deletePartner(${p.id})">Delete</button>
      </td>
    </tr>
  `).join('');
}

function openPartnerModal() {
  document.getElementById('partner-id').value = '';
  document.getElementById('partner-name').value = '';
  document.getElementById('partner-interchange-id').value = '';
  document.getElementById('partner-qualifier').value = 'ZZ';
  document.getElementById('partner-active').value = 'true';
  document.getElementById('partner-modal-title').textContent = 'Add Trading Partner';
  document.getElementById('partner-modal').classList.add('open');
}

function editPartner(p) {
  document.getElementById('partner-id').value = p.id;
  document.getElementById('partner-name').value = p.name;
  document.getElementById('partner-interchange-id').value = p.interchangeId;
  document.getElementById('partner-qualifier').value = p.interchangeQualifier || 'ZZ';
  document.getElementById('partner-active').value = p.isActive ? 'true' : 'false';
  document.getElementById('partner-modal-title').textContent = 'Edit Trading Partner';
  document.getElementById('partner-modal').classList.add('open');
}

async function savePartner() {
  const id = document.getElementById('partner-id').value;
  const body = {
    id: id ? parseInt(id) : 0,
    name: document.getElementById('partner-name').value,
    interchangeId: document.getElementById('partner-interchange-id').value,
    interchangeQualifier: document.getElementById('partner-qualifier').value,
    isActive: document.getElementById('partner-active').value === 'true'
  };
  const url = id ? apiUrl(`/api/tradingpartners/${id}`) : apiUrl('/api/tradingpartners');
  const method = id ? 'PUT' : 'POST';
  const res = await fetch(url, { method, headers: {'Content-Type':'application/json'}, body: JSON.stringify(body) });
  if (res.ok) {
    document.getElementById('partner-modal').classList.remove('open');
    await loadPartners();
    renderPartnersTable();
    toast('Partner saved successfully', 'success');
  } else {
    toast('Failed to save partner', 'error');
  }
}

async function deletePartner(id) {
  if (!confirm('Delete this trading partner?')) return;
  await fetch(apiUrl(`/api/tradingpartners/${id}`), { method: 'DELETE' });
  await loadPartners();
  renderPartnersTable();
  toast('Partner deleted', 'success');
}

// ─── Dashboard ────────────────────────────────────────────────────────────────
async function loadDashboard() {
  const requestId = ++dashboardRequestId;
  const rangeValue = document.getElementById('dash-range').value;
  const params = new URLSearchParams();

  let from;
  let to;
  if (rangeValue === 'custom') {
    const fromInput = document.getElementById('dash-from').value;
    const toInput = document.getElementById('dash-to').value;
    if (fromInput && toInput && fromInput > toInput) {
      toast('From date cannot be after To date', 'error');
      return;
    }

    const fromIso = toIsoUtc(fromInput, false);
    const toIso = toIsoUtc(toInput, true);
    if (fromInput && !fromIso) {
      toast('Invalid From date', 'error');
      return;
    }
    if (toInput && !toIso) {
      toast('Invalid To date', 'error');
      return;
    }

    if (fromInput) {
      from = fromInput;
      params.set('from', fromIso);
    }
    if (toInput) {
      to = toInput;
      params.set('to', toIso);
    }
  } else if (rangeValue !== 'all') {
    const days = parseInt(rangeValue, 10);
    from = new Date();
    from.setDate(from.getDate() - days);
    to = new Date();
    params.set('from', from.toISOString());
    params.set('to', to.toISOString());
  }

  if (selectedPartnerId) params.set('tradingPartnerId', selectedPartnerId);
  params.set('_ts', Date.now().toString());

  const res = await fetch(apiUrl('/api/metrics?' + params));
  const d = await res.json();

  // Ignore stale responses from older requests when user changes filters quickly.
  if (requestId !== dashboardRequestId) return;

  document.getElementById('kpi-total').textContent = fmt(d.totalClaims);
  document.getElementById('kpi-total-sub').textContent = `${d.totalTransactions} transactions`;
  document.getElementById('kpi-accepted').textContent = fmt(d.acceptedClaims);
  document.getElementById('kpi-accepted-rate').textContent = d.totalClaims ? pct(d.acceptedClaims / d.totalClaims) + ' acceptance rate' : '—';
  document.getElementById('kpi-rejected').textContent = fmt(d.rejectedClaims);
  document.getElementById('kpi-rejected-rate').textContent = d.totalClaims ? pct(d.rejectedClaims / d.totalClaims) + ' rejection rate' : '—';
  document.getElementById('kpi-pending').textContent = fmt(d.pendingClaims);
  document.getElementById('kpi-amount').textContent = '$' + money(d.totalBilledAmount);
  document.getElementById('kpi-txns').textContent = fmt(d.totalTransactions);

  renderBarChart(d.dailyVolumes);
  renderDonut(d.byClaimType);
  renderPartnerTable(d.byTradingPartner);
  renderRecentTable(d.recentTransactions);
}

function onDashboardRangeChange() {
  const isCustom = document.getElementById('dash-range').value === 'custom';
  const fromEl = document.getElementById('dash-from');
  const toEl = document.getElementById('dash-to');
  const refreshEl = document.getElementById('dash-refresh');

  fromEl.style.display = isCustom ? '' : 'none';
  toEl.style.display = isCustom ? '' : 'none';
  refreshEl.style.display = isCustom ? '' : 'none';

  if (isCustom && !fromEl.value && !toEl.value) {
    const today = new Date();
    const prior = new Date();
    prior.setDate(today.getDate() - 30);
    fromEl.value = prior.toISOString().slice(0, 10);
    toEl.value = today.toISOString().slice(0, 10);
  }

  loadDashboard();
}

function onCustomDateChange() {
  if (document.getElementById('dash-range').value !== 'custom') return;
  loadDashboard();
}

function toIsoUtc(dateText, endOfDay) {
  if (!dateText || !/^\d{4}-\d{2}-\d{2}$/.test(dateText)) return null;
  const suffix = endOfDay ? 'T23:59:59.999Z' : 'T00:00:00.000Z';
  const dt = new Date(dateText + suffix);
  return Number.isNaN(dt.getTime()) ? null : dt.toISOString();
}

function renderBarChart(volumes) {
  if (!volumes || !volumes.length) {
    document.getElementById('bar-chart').innerHTML = '<div class="empty-state" style="width:100%"><p>No volume data</p></div>';
    document.getElementById('chart-labels').innerHTML = '';
    return;
  }
  const maxClaims = Math.max(...volumes.map(v => v.claims), 1);
  const barChart = document.getElementById('bar-chart');
  const labels = document.getElementById('chart-labels');
  const showEvery = Math.ceil(volumes.length / 10);
  const chartHeightPx = 140;

  const scaledHeightPx = (value) => {
    if (!value) return 0;
    // Keep non-zero values visibly bar-like instead of hairline slivers.
    return Math.max(14, Math.round((value / maxClaims) * chartHeightPx));
  };

  barChart.innerHTML = volumes.map(v => `
    <div class="bar-group" title="${v.date?.split('T')[0]}: ${v.claims} total, ${v.accepted} accepted, ${v.rejected} rejected">
      <div class="bar bar-total" style="height:${scaledHeightPx(v.claims)}px"></div>
      <div class="bar bar-accepted" style="height:${scaledHeightPx(v.accepted)}px"></div>
      <div class="bar bar-rejected" style="height:${scaledHeightPx(v.rejected)}px"></div>
    </div>
  `).join('');

  labels.innerHTML = volumes.map((v, i) => {
    const d = v.date ? new Date(v.date) : null;
    const label = d ? `${d.getMonth()+1}/${d.getDate()}` : '';
    return `<div class="chart-label">${i % showEvery === 0 ? label : ''}</div>`;
  }).join('');
}

function renderDonut(byType) {
  const svg = document.getElementById('donut-svg');
  const legend = document.getElementById('donut-legend');
  if (!byType || !byType.length) {
    legend.innerHTML = '<div style="color:var(--muted);font-size:13px">No data</div>';
    return;
  }
  const colors = ['#00e5a0','#0088ff','#ffc800','#ff3860','#a064ff'];
  const total = byType.reduce((s, t) => s + t.count, 0) || 1;
  const r = 45, cx = 60, cy = 60, circ = 2 * Math.PI * r;
  let offset = 0;
  const circles = byType.map((t, i) => {
    const dash = (t.count / total) * circ;
    const gap = circ - dash;
    const c = `<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="${colors[i % colors.length]}"
      stroke-width="18" stroke-dasharray="${dash} ${gap}"
      stroke-dashoffset="${-offset}" transform="rotate(-90 60 60)" />`;
    offset += dash;
    return c;
  }).join('');

  svg.innerHTML = `<circle cx="60" cy="60" r="45" fill="none" stroke="var(--border)" stroke-width="18"/>` + circles;

  legend.innerHTML = byType.map((t, i) => `
    <div class="legend-item">
      <div class="legend-dot" style="background:${colors[i%colors.length]}"></div>
      <div>
        <div class="legend-count" style="color:${colors[i%colors.length]}">${fmt(t.count)}</div>
        <div class="legend-label">${t.claimType}</div>
      </div>
    </div>
  `).join('');
}

function renderPartnerTable(partners) {
  const tbody = document.getElementById('partner-tbody');
  if (!partners || !partners.length) {
    tbody.innerHTML = '<tr><td colspan="7"><div class="empty-state"><p>No claims in range</p></div></td></tr>';
    return;
  }
  tbody.innerHTML = partners.map(p => `
    <tr>
      <td><strong>${p.tradingPartnerName}</strong></td>
      <td style="font-family:var(--mono)">${fmt(p.totalClaims)}</td>
      <td style="color:var(--accent);font-family:var(--mono)">${fmt(p.accepted)}</td>
      <td style="color:var(--danger);font-family:var(--mono)">${fmt(p.rejected)}</td>
      <td style="color:var(--accent2);font-family:var(--mono)">${fmt(p.pending)}</td>
      <td>$${money(p.totalAmount)}</td>
      <td>
        <span style="font-family:var(--mono);font-size:13px">${p.acceptanceRate}%</span>
        <div class="progress-bar-wrap"><div class="progress-bar-fill" style="width:${p.acceptanceRate}%"></div></div>
      </td>
    </tr>
  `).join('');
}

function renderRecentTable(txns) {
  const tbody = document.getElementById('recent-tbody');
  if (!txns || !txns.length) {
    tbody.innerHTML = '<tr><td colspan="7"><div class="empty-state"><p>No transactions yet. Upload an EDI file to get started.</p></div></td></tr>';
    return;
  }
  tbody.innerHTML = txns.map(t => `
    <tr>
      <td>${typeBadge(t.transactionType)}</td>
      <td style="font-family:var(--mono);font-size:12px">${t.controlNumber || '—'}</td>
      <td style="font-size:12px;max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${t.fileName || ''}">${t.fileName || '—'}</td>
      <td>${t.tradingPartner}</td>
      <td style="font-family:var(--mono)">${t.claimCount}</td>
      <td>${statusBadge(t.status)}</td>
      <td style="font-family:var(--mono);font-size:11px;color:var(--muted)">${relativeTime(t.receivedAt)}</td>
    </tr>
  `).join('');
}

// ─── Transactions table ───────────────────────────────────────────────────────
async function loadTransactions() {
  const type = document.getElementById('tx-type').value;
  const params = new URLSearchParams({ page: txPage, pageSize: PAGE_SIZE });
  if (type) params.set('type', type);
  if (selectedPartnerId) params.set('tradingPartnerId', selectedPartnerId);

  const res = await fetch(apiUrl('/api/transactions?' + params));
  const data = await res.json();

  document.getElementById('tx-count').textContent = `${data.total} total`;

  const tbody = document.getElementById('tx-tbody');
  if (!data.items.length) {
    tbody.innerHTML = '<tr><td colspan="8"><div class="empty-state"><p>No transactions found.</p></div></td></tr>';
    return;
  }
  tbody.innerHTML = data.items.map(t => `
    <tr>
      <td style="font-family:var(--mono);color:var(--muted);font-size:11px">${t.id}</td>
      <td>${typeBadge(t.transactionType)}</td>
      <td style="font-family:var(--mono);font-size:12px">${t.controlNumber || '—'}</td>
      <td style="font-size:12px;max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${t.fileName || ''}">${t.fileName || '—'}</td>
      <td>${t.tradingPartner}</td>
      <td style="font-family:var(--mono)">${t.claimCount}</td>
      <td>${statusBadge(t.status)}</td>
      <td style="font-family:var(--mono);font-size:11px;color:var(--muted)">${relativeTime(t.receivedAt)}</td>
    </tr>
  `).join('');

  renderPagination('tx-pagination', data.total, txPage, PAGE_SIZE, p => { txPage = p; loadTransactions(); });
}

// ─── Claims table ─────────────────────────────────────────────────────────────
async function loadClaims() {
  const status = document.getElementById('claim-status').value;
  const from = document.getElementById('claim-from').value;
  const to = document.getElementById('claim-to').value;
  const params = new URLSearchParams({ page: claimPage, pageSize: PAGE_SIZE });
  if (status) params.set('status', status);
  if (from) params.set('from', new Date(from).toISOString());
  if (to) params.set('to', new Date(to).toISOString());
  if (selectedPartnerId) params.set('tradingPartnerId', selectedPartnerId);

  const res = await fetch(apiUrl('/api/claims?' + params));
  const data = await res.json();
  document.getElementById('claim-count').textContent = `${data.total} total`;

  const tbody = document.getElementById('claim-tbody');
  if (!data.items.length) {
    tbody.innerHTML = '<tr><td colspan="8"><div class="empty-state"><p>No claims found.</p></div></td></tr>';
    return;
  }
  tbody.innerHTML = data.items.map(c => `
    <tr>
      <td style="font-family:var(--mono);font-size:12px">${c.claimNumber || '—'}</td>
      <td>${c.patientName || '—'}</td>
      <td style="font-size:12px">${c.providerName || '—'}</td>
      <td style="font-size:12px">${c.payerName || '—'}</td>
      <td>${claimTypeBadge(c.claimType)}</td>
      <td style="font-family:var(--mono)">$${money(c.totalAmount)}</td>
      <td>${statusBadge(c.status)}</td>
      <td style="font-family:var(--mono);font-size:11px;color:var(--muted)">${c.serviceDateFrom ? c.serviceDateFrom.split('T')[0] : '—'}</td>
    </tr>
  `).join('');

  renderPagination('claim-pagination', data.total, claimPage, PAGE_SIZE, p => { claimPage = p; loadClaims(); });
}

// ─── Acknowledgments table ────────────────────────────────────────────────────
async function loadAcks() {
  const ackType = document.getElementById('ack-type').value;
  const params = new URLSearchParams({ page: ackPage, pageSize: PAGE_SIZE });
  if (ackType) params.set('ackType', ackType);
  if (selectedPartnerId) params.set('tradingPartnerId', selectedPartnerId);

  const res = await fetch(apiUrl('/api/acknowledgments?' + params));
  const data = await res.json();

  const tbody = document.getElementById('ack-tbody');
  if (!data.items.length) {
    tbody.innerHTML = '<tr><td colspan="7"><div class="empty-state"><p>No acknowledgments found.</p></div></td></tr>';
    return;
  }
  tbody.innerHTML = data.items.map(a => `
    <tr>
      <td>${typeBadge(a.ackType)}</td>
      <td style="font-family:var(--mono);font-size:12px">${a.controlNumber || '—'}</td>
      <td style="font-size:12px;max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${a.fileName || ''}">${a.fileName || '—'}</td>
      <td>${a.tradingPartner}</td>
      <td><span class="badge ${a.acknowledgmentCode === 'A' ? 'badge-accepted' : a.acknowledgmentCode === 'R' ? 'badge-rejected' : 'badge-received'}">${a.acknowledgmentCode || '—'}</span></td>
      <td style="font-size:12px;max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${a.description || ''}">${a.description || '—'}</td>
      <td style="font-family:var(--mono);font-size:11px;color:var(--muted)">${relativeTime(a.receivedAt)}</td>
    </tr>
  `).join('');

  renderPagination('ack-pagination', data.total, ackPage, PAGE_SIZE, p => { ackPage = p; loadAcks(); });
}

// ─── Upload ───────────────────────────────────────────────────────────────────
let selectedFiles = [];

function fileSelected(input) {
  selectedFiles = Array.from(input.files || []);
  renderSelectedFiles();
}

function renderSelectedFiles() {
  const el = document.getElementById('file-selected-name');
  if (!selectedFiles.length) {
    el.style.display = 'none';
    el.textContent = '';
    return;
  }

  const totalSizeKb = selectedFiles.reduce((sum, f) => sum + (f.size / 1024), 0);
  const preview = selectedFiles.slice(0, 3).map(f => f.name).join(', ');
  const suffix = selectedFiles.length > 3 ? ` +${selectedFiles.length - 3} more` : '';
  el.style.display = 'block';
  el.textContent = `📄 ${selectedFiles.length} file(s): ${preview}${suffix} (${totalSizeKb.toFixed(1)} KB)`;
}

function setupDropZone() {
  const zone = document.getElementById('drop-zone');
  zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('dragover'); });
  zone.addEventListener('dragleave', () => zone.classList.remove('dragover'));
  zone.addEventListener('drop', e => {
    e.preventDefault();
    zone.classList.remove('dragover');
    const files = Array.from(e.dataTransfer.files || []);
    if (files.length) {
      selectedFiles = files;
      renderSelectedFiles();
    }
  });
}

async function uploadFile() {
  const partnerId = document.getElementById('upload-partner').value;
  const resultEl = document.getElementById('upload-result');

  if (!selectedFiles.length) { resultEl.className = 'result-box error'; resultEl.style.display = 'block'; resultEl.textContent = 'Please select at least one file to upload.'; return; }

  document.getElementById('upload-spinner').style.display = 'inline-block';
  document.getElementById('upload-btn').disabled = true;
  resultEl.style.display = 'none';

  const form = new FormData();
  if (partnerId) form.append('tradingPartnerId', partnerId);
  selectedFiles.forEach(file => form.append('files', file));

  try {
    const res = await fetch(apiUrl('/api/edi/upload'), { method: 'POST', body: form });
    const data = await res.json();
    resultEl.style.display = 'block';
    if (res.ok) {
      if (Array.isArray(data.results)) {
        const failed = data.results.filter(r => !r.success);
        resultEl.className = failed.length ? 'result-box error' : 'result-box success';
        resultEl.textContent =
          `Processed ${data.totalFiles} file(s): ${data.successCount} succeeded, ${data.failureCount} failed.` +
          (failed.length ? ` Failed: ${failed.slice(0, 3).map(f => f.fileName).join(', ')}` : '');
        toast(`Upload complete: ${data.successCount}/${data.totalFiles} succeeded`, failed.length ? 'error' : 'success');
      } else {
        resultEl.className = 'result-box success';
        resultEl.textContent = `✓ ${data.message} (${data.transactionType}, Control: ${data.controlNumber}, Claims: ${data.claimsProcessed})`;
        toast(data.message, 'success');
      }
      loadDashboard();
    } else {
      resultEl.className = 'result-box error';
      resultEl.textContent = `✗ ${data.message || 'Upload failed'}` + (data.errors?.length ? ': ' + data.errors.join(', ') : '');
    }
  } catch (e) {
    resultEl.className = 'result-box error';
    resultEl.style.display = 'block';
    resultEl.textContent = '✗ Network error: ' + e.message;
  } finally {
    document.getElementById('upload-spinner').style.display = 'none';
    document.getElementById('upload-btn').disabled = false;
  }
}

// ─── Helpers ──────────────────────────────────────────────────────────────────
function renderPagination(id, total, page, pageSize, onPage) {
  const totalPages = Math.ceil(total / pageSize);
  const el = document.getElementById(id);
  el.innerHTML = `
    <button class="page-btn" ${page <= 1 ? 'disabled' : ''} onclick="(${onPage.toString()})(${page - 1})">← Prev</button>
    <span>Page ${page} of ${totalPages} (${total} records)</span>
    <button class="page-btn" ${page >= totalPages ? 'disabled' : ''} onclick="(${onPage.toString()})(${page + 1})">Next →</button>
  `;
}

function statusBadge(s) {
  const map = { Accepted: 'badge-accepted', Rejected: 'badge-rejected', Received: 'badge-received' };
  return `<span class="badge ${map[s] || 'badge-received'}">${s || '—'}</span>`;
}

function typeBadge(t) {
  const map = { TA1: 'badge-ta1', '999': 'badge-999', '277CA': 'badge-277ca', '837P': 'badge-837p', '837I': 'badge-837i', '837D': 'badge-837d' };
  return `<span class="badge ${map[t] || 'badge-received'}">${t || '—'}</span>`;
}

function claimTypeBadge(t) {
  const map = { Professional: 'badge-837p', Institutional: 'badge-837i', Dental: 'badge-837d' };
  return `<span class="badge ${map[t] || 'badge-received'}" style="font-size:10px">${t || '—'}</span>`;
}

function fmt(n) { return (n ?? 0).toLocaleString(); }
function money(n) { return (n ?? 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
function pct(n) { return (n * 100).toFixed(1) + '%'; }

function relativeTime(d) {
  if (!d) return '—';
  const diff = Date.now() - new Date(d).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 1) return 'just now';
  if (mins < 60) return `${mins}m ago`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return `${hrs}h ago`;
  const days = Math.floor(hrs / 24);
  if (days < 7) return `${days}d ago`;
  return new Date(d).toLocaleDateString();
}

function toast(msg, type = 'success') {
  const el = document.createElement('div');
  el.className = `toast ${type}`;
  el.innerHTML = `<span>${type === 'success' ? '✓' : '✗'}</span><span>${msg}</span>`;
  document.getElementById('toasts').appendChild(el);
  setTimeout(() => el.remove(), 4000);
}
</script>
